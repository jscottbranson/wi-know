CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# In the NimBLE revision pinned by IDF 6.1, dynamic host initialization still
# returns early on OOM without failing port init. Keep host state static.
CONFIG_BT_NIMBLE_STATIC_TO_DYNAMIC=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_EXT_ADV=y
# Passive reception does not use periodic advertising/synchronization or reserve
# connection/advertiser state. Retain extended scanning and both receive PHYs.
CONFIG_BT_NIMBLE_ENABLE_PERIODIC_ADV=n
CONFIG_BT_NIMBLE_ENABLE_PERIODIC_SYNC=n
CONFIG_BT_LE_EXT_ADV_RESERVED_MEMORY_COUNT=0
CONFIG_BT_LE_CONN_RESERVED_MEMORY_COUNT=0
# Only explicitly allocated application state goes into PSRAM. DMA buffers and
# task stacks remain internal; boards without PSRAM may still boot.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Prefer RAM headroom over Wi-Fi throughput optimizations for passive capture.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=13312
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# ESP-IDF 6.1 lists Zcmp as incompatible with ESP32-C5.
CONFIG_COMPILER_ENABLE_RISCV_ZCMP=n
CONFIG_FATFS_LFN_HEAP=y
# Retain embedded sector buffers rather than the new dynamic-buffer default.
CONFIG_FATFS_USE_DYN_BUFFERS=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
